    "@modelcontextprotocol/sdk": "^1.26.0",
    "@ofocus/mcp": "workspace:*",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.9.3"
  }
}
