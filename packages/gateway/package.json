{
  "name": "@ofocus/gateway",
  "version": "0.2.1",
  "description": "Remote-MCP gateway exposing OmniFocus to claude.ai and ChatGPT over OAuth 2.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ofocus-gateway": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "start": "node dist/index.js",
