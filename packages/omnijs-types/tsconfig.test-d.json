{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "lib": ["ES2022"],
    "paths": {
      "@ofocus/omnijs-types": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*"]
}
